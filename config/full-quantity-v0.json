    "relativeTolerance": 0.05,
    "units": ["个", "m", "m2", "m3"],
    "metrics": ["coverage", "MAE", "WAPE", "toleranceHitRate", "exactRate", "benchScore"],
    "aggregateAcrossUnits": false
